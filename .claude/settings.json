{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pip install *)",
      "Bash(python -m build *)",
      "Bash(twine check *)",
      "Bash(git status *)",
      "Bash(git --no-pager diff *)",
      "Bash(git --no-pager log *)",
      "Bash(git --no-pager show *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git reset --hard*)",
      "Bash(twine upload *)"
    ]
  },
  "defaultMode": "acceptEdits",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Verify that all claims made in this session about test results, file states, or command outputs were backed by actually running the corresponding command in this session, not asserted from memory or a prior summary. If any claim lacks a matching real command execution in the transcript, block and say what needs to be re-run.",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
